      "versionCode": 3
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "name": "Merge Heroes Unite War",
      "favicon": "./app/assets/branding_app_icon__1254x1254.png"
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": false,
          "recordAudioAndroid": false,
          "enableBackgroundPlayback": false,
          "enableBackgroundRecording": false
        }
      ]
    ],
    "icon": "./app/assets/branding_app_icon__1254x1254.png"
