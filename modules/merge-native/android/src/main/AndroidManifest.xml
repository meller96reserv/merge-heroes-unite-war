<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <application>
    <!-- Explicit SDK initialization only on a requested rewarded operation. -->
    <provider android:name="com.startapp.sdk.adsbase.StartAppInitProvider" android:authorities="${applicationId}.startappinitprovider" tools:node="remove" />
    <meta-data android:name="com.startapp.sdk.RETURN_ADS_ENABLED" android:value="false" tools:replace="android:value" />
    <meta-data android:name="com.startapp.sdk.SPLASH_ENABLED" android:value="false" tools:replace="android:value" />
  </application>
</manifest>
