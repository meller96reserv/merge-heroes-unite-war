{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/spikes/bridge-probe.schema.json",
  "title": "bridge",
  "description": "Development-only native feasibility fixture; v1 envelope plus two production payloads and isolated probe types. Not the production catalogue.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "enum": [
        "game.ready",
        "app.initialize",
        "probe.ping",
        "probe.pong",
        "probe.color",
        "probe.report",
        "probe.audioState",
        "probe.audioMute"
      ]
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "type",
    "requestId",
    "sessionId",
    "generation",
    "sequence",
    "timestamp",
    "payload"
  ],
  "$defs": {
    "game.ready": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "gameBuild": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "supportedVersions": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "minItems": 1
        },
        "capabilities": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "minItems": 0
        }
      },
      "required": [
        "gameBuild",
        "supportedVersions",
        "capabilities"
      ]
    },
    "app.initialize": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "userNamespace": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "environment": {
          "enum": [
            "development",
            "test",
            "production"
          ]
        },
        "hostBuild": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "safeArea": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "top": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "right": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "bottom": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "left": {
              "type": "integer",
              "minimum": 0,
              "maximum": 9007199254740991
            },
            "unit": {
              "enum": [
                "logicalPoints"
              ]
            },
            "scale": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          },
          "required": [
            "top",
            "right",
            "bottom",
            "left",
            "unit",
            "scale"
          ]
        },
        "settings": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "musicGain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "sfxGain": {
              "type": "number",
              "minimum": 0,
              "maximum": 1
            },
            "haptics": {
              "type": "boolean"
            },
            "reducedMotion": {
              "type": "boolean"
            },
            "notifications": {
              "type": "boolean"
            }
          },
          "required": [
            "musicGain",
            "sfxGain",
            "haptics",
            "reducedMotion",
            "notifications"
          ]
        },
        "settingsRevision": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "initialRoute": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "externalRewardsEnabled": {
          "type": "boolean"
        }
      },
      "required": [
        "userNamespace",
        "environment",
        "hostBuild",
        "safeArea",
        "settings",
        "settingsRevision",
        "initialRoute",
        "externalRewardsEnabled"
      ]
    },
    "probe.ping": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "token"
      ]
    },
    "probe.pong": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "token": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        }
      },
      "required": [
        "token"
      ]
    },
    "probe.color": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "color": {
          "enum": [
            "cyan",
            "violet"
          ]
        }
      },
      "required": [
        "color"
      ]
    },
    "probe.report": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "caseId": {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        "result": {
          "type": "string"
        },
        "applied": {
          "type": "integer",
          "minimum": 0
        }
      },
      "required": [
        "caseId",
        "result",
        "applied"
      ]
    },
    "probe.audioState": {
      "type": "object",
      "properties": {
        "focus": {
          "type": "boolean"
        },
        "muted": {
          "type": "boolean"
        }
      },
      "required": [
        "focus",
        "muted"
      ],
      "additionalProperties": false
    },
    "probe.audioMute": {
      "type": "object",
      "properties": {
        "muted": {
          "type": "boolean"
        }
      },
      "required": [
        "muted"
      ],
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "const": "game.ready"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/game.ready"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "app.initialize"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/app.initialize"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe.ping"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/probe.ping"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe.pong"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/probe.pong"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe.color"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/probe.color"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe.report"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/probe.report"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe.audioState"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/probe.audioState"
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "type": {
            "const": "probe.audioMute"
          }
        }
      },
      "then": {
        "properties": {
          "payload": {
            "$ref": "#/$defs/probe.audioMute"
          }
        }
      }
    }
  ]
}
