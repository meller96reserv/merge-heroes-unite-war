# Public, owner-approved HTTPS documents; never put credentials in these URLs.
# Required before distribution. No invented fallback policy or unrelated website.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=

# Owner-issued Start.io application IDs; required separately for each native app.
EXPO_PUBLIC_STARTIO_ANDROID_APP_ID=
EXPO_PUBLIC_STARTIO_IOS_APP_ID=
# Debug native builds only; production code forces test inventory off.
EXPO_PUBLIC_STARTIO_TEST_ADS=0
# Optional override; otherwise app.config.js reads the app-specific TZ UUID.
EXPO_PUBLIC_APPMETRICA_API_KEY=
