{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/bridge.schema.json",
  "title": "bridge",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "const": 1
    },
    "type": {
      "enum": [
        "game.ready",
        "game.error",
        "game.exitRequested",
        "progress.stageChanged",
        "currency.changed",
        "reward.claimed",
        "purchase.requested",
        "ad.rewardRequested",
        "analytics.event",
        "save.changed",
        "player.levelChanged",
        "app.initialize",
        "app.userChanged",
        "app.purchaseResult",
        "app.rewardGranted",
        "app.pause",
        "app.resume",
        "app.settingsChanged",
        "app.deepLink",
        "app.notificationOpened"
      ]
    },
    "requestId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "sessionId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "generation": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "sequence": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "timestamp": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "payload": {
      "type": "object"
    }
  },
  "required": [
    "version",
    "type",
    "requestId",
    "sessionId",
    "generation",
    "sequence",
    "timestamp",
    "payload"
  ],
  "$comment": "SUPERSEDED historical spike contract; ADR-007 production uses typed platform services."
}
