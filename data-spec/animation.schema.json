{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/animation.schema.json",
  "title": "animation",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dataVersion": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "evidenceMode": {
      "enum": [
        "OBSERVED",
        "MEASURED",
        "DERIVED",
        "PROPOSED"
      ]
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "trigger": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "durationMs": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "easing": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "releaseMarkerMs": {
            "anyOf": [
              {
                "type": "integer",
                "minimum": 0,
                "maximum": 9007199254740991
              },
              {
                "type": "null"
              }
            ]
          },
          "vfxId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "audioEventId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "hapticId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "interruptPolicy": {
            "enum": [
              "cancelAndReconcile",
              "finishCriticalMarker",
              "resumeFromState"
            ]
          },
          "pooled": {
            "type": "boolean"
          },
          "maxConcurrent": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "qualityFallback": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          }
        },
        "required": [
          "id",
          "trigger",
          "durationMs",
          "easing",
          "releaseMarkerMs",
          "vfxId",
          "audioEventId",
          "hapticId",
          "interruptPolicy",
          "pooled",
          "maxConcurrent",
          "qualityFallback"
        ]
      },
      "minItems": 0
    }
  },
  "required": [
    "schemaVersion",
    "dataVersion",
    "evidenceMode",
    "entries"
  ]
}
