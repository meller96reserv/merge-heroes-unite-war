{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/wheel.schema.json",
  "title": "wheel",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "freeCooldownMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "priceCurrencyId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "price": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "outcomes": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "segmentId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "rewardId": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "freeSpins": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "id",
          "segmentId",
          "weight",
          "rewardId",
          "freeSpins"
        ]
      },
      "minItems": 1
    },
    "segments": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "labelKey": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "angleDegrees": {
            "type": "number",
            "minimum": 0,
            "exclusiveMaximum": 360
          }
        },
        "required": [
          "id",
          "labelKey",
          "angleDegrees"
        ]
      },
      "minItems": 1
    },
    "evidenceMode": {
      "enum": [
        "PROPOSED",
        "OBSERVED"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "freeCooldownMs",
    "priceCurrencyId",
    "price",
    "outcomes",
    "segments",
    "evidenceMode"
  ]
}
