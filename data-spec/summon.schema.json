{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/summon.schema.json",
  "title": "summon",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "enabled": {
      "type": "boolean"
    },
    "poolVersion": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "entries": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "definitionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "weight": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          }
        },
        "required": [
          "definitionId",
          "weight"
        ]
      },
      "minItems": 1
    },
    "currencyId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "costOne": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "costTen": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]*)$"
    },
    "pityLimit": {
      "anyOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "enabled",
    "poolVersion",
    "entries",
    "currencyId",
    "costOne",
    "costTen",
    "pityLimit"
  ]
}
