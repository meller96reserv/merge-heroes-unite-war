{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/stage.schema.json",
  "title": "stage",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "ordinal": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "chapter": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "displayIndex": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "worldId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "waves": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "enemyId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "count": {
            "type": "integer",
            "minimum": 1,
            "maximum": 32
          }
        },
        "required": [
          "enemyId",
          "count"
        ]
      },
      "minItems": 1,
      "maxItems": 100
    },
    "firstClearRewardId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "nextStageId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "boss": {
      "anyOf": [
        {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "timerMs": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "farmStageId": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            "retryPolicy": {
              "enum": [
                "manual",
                "automatic"
              ]
            },
            "tiePolicy": {
              "enum": [
                "lethal_before_timeout"
              ]
            }
          },
          "required": [
            "timerMs",
            "farmStageId",
            "retryPolicy",
            "tiePolicy"
          ]
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0
    }
  },
  "required": [
    "id",
    "ordinal",
    "chapter",
    "displayIndex",
    "worldId",
    "waves",
    "firstClearRewardId",
    "nextStageId",
    "boss",
    "evidenceIds"
  ]
}
