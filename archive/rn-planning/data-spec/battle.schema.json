{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/battle.schema.json",
  "title": "battle",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "stepMs": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "maxCatchUp": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "targetingPolicy": {
      "enum": [
        "spawnOrder",
        "nearest",
        "verified"
      ]
    },
    "staleProjectilePolicy": {
      "enum": [
        "cancel",
        "retargetVerified"
      ]
    },
    "damageModel": {
      "enum": [
        "proposedSubtractDefense",
        "verified"
      ]
    },
    "rounding": {
      "enum": [
        "floor",
        "round",
        "ceil"
      ]
    },
    "minimumDamage": {
      "type": "integer",
      "minimum": 0,
      "maximum": 9007199254740991
    },
    "encounterRestore": {
      "enum": [
        "restartEncounter",
        "exactCheckpoint"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "stepMs",
    "maxCatchUp",
    "targetingPolicy",
    "staleProjectilePolicy",
    "damageModel",
    "rounding",
    "minimumDamage",
    "encounterRestore"
  ]
}
