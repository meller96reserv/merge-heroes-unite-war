{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/hero.schema.json",
  "title": "hero",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "family": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "tier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "rarityId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "attackType": {
      "enum": [
        "melee",
        "ranged",
        "magic"
      ]
    },
    "baseStats": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attack": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "defense": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "hp": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "attackIntervalMs": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "critChanceBp": {
          "type": "integer",
          "minimum": 0,
          "maximum": 10000
        },
        "critMultiplierBp": {
          "type": "integer",
          "minimum": 10000,
          "maximum": 100000
        }
      },
      "required": [
        "attack",
        "defense",
        "hp",
        "attackIntervalMs",
        "critChanceBp",
        "critMultiplierBp"
      ]
    },
    "visualId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "portraitId": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "animationProfile": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "audioProfile": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
    },
    "projectileId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "unlockId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "evidenceIds": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
      },
      "minItems": 0
    }
  },
  "required": [
    "id",
    "family",
    "tier",
    "rarityId",
    "attackType",
    "baseStats",
    "visualId",
    "portraitId",
    "animationProfile",
    "audioProfile",
    "projectileId",
    "unlockId",
    "evidenceIds"
  ]
}
