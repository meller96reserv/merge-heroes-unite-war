{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kisel.invalid/schemas/merge.schema.json",
  "title": "merge",
  "description": "PROPOSED planning contract. Validate cross-record references separately. Not reference balance.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "manualEnabled": {
      "type": "boolean"
    },
    "autoPolicy": {
      "enum": [
        "disabled",
        "slotOrder",
        "tierAscending",
        "purchaseFed"
      ]
    },
    "autoUnlockId": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
        },
        {
          "type": "null"
        }
      ]
    },
    "compatibility": {
      "enum": [
        "sameFamilyAndTier",
        "explicitPairs"
      ]
    },
    "pairs": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "sourceDefinitionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "targetDefinitionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          },
          "resultDefinitionId": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          }
        },
        "required": [
          "sourceDefinitionId",
          "targetDefinitionId",
          "resultDefinitionId"
        ]
      },
      "minItems": 0
    },
    "manualDestination": {
      "const": "dropTarget"
    },
    "autoDestination": {
      "enum": [
        "lowerSlot",
        "purchaseTarget"
      ]
    },
    "deployedPolicy": {
      "enum": [
        "reject",
        "preserveDestination",
        "inheritEither"
      ]
    },
    "maxTier": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "board": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "slotCount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "columns": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "initialUnlocked": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "slotUnlockIds": {
          "type": "array",
          "items": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
              },
              {
                "type": "null"
              }
            ]
          },
          "minItems": 0
        }
      },
      "required": [
        "slotCount",
        "columns",
        "initialUnlocked",
        "slotUnlockIds"
      ],
      "description": "Merge/dock ownership slots only. Visible battle positions are presentation layout; simultaneous deploymentCapacity is saved account progression, not a board/platform count."
    },
    "activation": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "durationMs": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "costCurrencyId": {
          "anyOf": [
            {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
            },
            {
              "type": "null"
            }
          ]
        },
        "costAmount": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]*)$"
        },
        "timeBasis": {
          "enum": [
            "wallUtcProposed",
            "verified"
          ]
        },
        "freeActivationPolicy": {
          "enum": [
            "developmentGrant",
            "disabled",
            "verifiedProvider"
          ]
        },
        "evidenceIds": {
          "type": "array",
          "items": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]*$"
          }
        }
      },
      "required": [
        "durationMs",
        "costCurrencyId",
        "costAmount",
        "timeBasis",
        "freeActivationPolicy",
        "evidenceIds"
      ]
    }
  },
  "required": [
    "schemaVersion",
    "manualEnabled",
    "autoPolicy",
    "autoUnlockId",
    "compatibility",
    "pairs",
    "manualDestination",
    "autoDestination",
    "deployedPolicy",
    "maxTier",
    "board",
    "activation"
  ]
}
